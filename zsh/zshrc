# fz <file>  OR  cmd | fz — fuzzy search a file or piped input with preview pane
fz() {
  local file
  if [[ ! -t 0 ]]; then
    # piped input — buffer stdin to a temp file so preview can re-read it
    file=$(mktemp)
    cat - > "$file"
    trap "rm -f $file" EXIT
  else
    [[ -z "$1" ]] && { echo "Usage: fz <file>  OR  cmd | fz"; return 1; }
    file="${1:A}"
    [[ ! -f "$file" ]] && { echo "fz: not a file: $1"; return 1; }
  fi
  awk '{print NR"\t"$0}' "$file" | \
  fzf --ansi \
      --delimiter='\t' \
      --with-nth=2.. \
      --preview "awk -v n={1} 'NR>=n-4 && NR<=n+12' \"$file\"" \
      --preview-window=right:55%:wrap | \
  cut -f2-
}

# Shortcut file aliases — preview pane shows ~15 lines of context around match
