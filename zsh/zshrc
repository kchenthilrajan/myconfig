prep-ref() {
  local reset="\e[0m"
  {
    for file in ~/myconfig/refs/prep/ref_*.md ~/myconfig/refs/prep/patterns.md ~/myconfig/refs/prep/interview_algorithm_patterns.md ~/myconfig/refs/prep/signals_and_shapes.md ~/myconfig/refs/prep/drill_protocol.md ~/myconfig/refs/prep/invariant_drill.md; do
      [[ -f "$file" ]] || continue
      local label="${${file:t}/.md/}"
      local color="\e[36m"
      local linenum=0
      while IFS= read -r line; do
        (( linenum++ ))
        [[ -n "$line" ]] && printf "%s\t%d\t${color}[%-28s]${reset} %s\n" "$file" "$linenum" "$label" "$line"
      done < "$file"
    done
  } | fzf --prompt="prep> " --ansi \
      --delimiter='\t' \
      --with-nth=3.. \
      --preview "awk -v n={2} 'NR>=n-4 && NR<=n+12' {1}" \
      --preview-window=right:55%:wrap | \
  cut -f3-
}

# Unified reference search across all shortcut/command files
unalias ref 2>/dev/null
ref() {
  local -a labels colors files
  labels=(nvim        tmux        shell       consolidated cli-nav     docker      projects   )
  colors=("\e[35m"    "\e[32m"    "\e[33m"    "\e[34m"     "\e[31m"    "\e[36m"    "\e[93m"   )
  files=(
    ~/myconfig/refs/nvim-shortcuts.md
    ~/myconfig/refs/tmux-shortcuts.md
    ~/myconfig/refs/shell-commands.md
    ~/myconfig/refs/commands_consolidated.md
    ~/myconfig/refs/cli_navigate_keyboard_shortcuts
    ~/myconfig/refs/docker-shortcuts.md
    ~/myconfig/refs/project-workflows.md
  )
  local reset="\e[0m"
  {
    for i in {1..${#labels[@]}}; do
      local color="${colors[$i]}"
      local label="${labels[$i]}"
      local file="${files[$i]:A}"
      local linenum=0
      while IFS= read -r line; do
        (( linenum++ ))
        [[ -n "$line" ]] && printf "%s\t%d\t${color}[%-12s]${reset} %s\n" "$file" "$linenum" "$label" "$line"
      done < "$file"
    done
  } | fzf --prompt="ref> " --ansi \
      --delimiter='\t' \
      --with-nth=3.. \
      --preview "awk -v n={2} 'NR>=n-4 && NR<=n+12' {1}" \
      --preview-window=right:55%:wrap | \
  cut -f3-
}

